# The circle is 3.4 pt across, white inside.
flag port
pin 1 0 0 r
box 0 0 0 0
blank 1.7 0 1.67 0.33 1.57 0.65 1.41 0.94 1.2 1.2 0.94 1.41 0.65 1.57 0.33 \
  1.67 0 1.7 -0.33 1.67 -0.65 1.57 -0.94 1.41 -1.2 1.2 -1.41 0.94 -1.57 0.65 \
  -1.67 0.33 -1.7 0 -1.67 -0.33 -1.57 -0.65 -1.41 -0.94 -1.2 -1.2 -0.94 \
  -1.41 -0.65 -1.57 -0.33 -1.67 0 -1.7 0.33 -1.67 0.65 -1.57 0.94 -1.41 1.2 \
  -1.2 1.41 -0.94 1.57 -0.65 1.67 -0.33
circle 0 0 1.7
