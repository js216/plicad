%%PliCadPaper: 17 11
%%PliCadRoom: 0.9 0.9 16.1 10.1
%%PliCadKeep: 6.8 0.5 16.5 3
%%PliCadNotes: 0.9 0.9 6.4 10.1
%%PliCadRevisions: 10 16.5 10.5 0.25
%%PliCadFields: Title Number Rev Drawn Eng Filename

% The border and its zones, numbered from the right and lettered from
% the foot.
/BW 17 def /BH 11 def /NX 4 def /NY 2 def
0.02 setlinewidth [] 0 setdash 0.5 0.5 BW 1 sub BH 1 sub rectstroke
0.012 setlinewidth
/ZW BW 1 sub NX div def /ZH BH 1 sub NY div def
0 1 NX 1 sub { /i exch def /zx BW 0.5 sub i ZW mul sub def
  i 0 gt { zx 0.2 zx 0.5 LN zx BH 0.5 sub zx BH 0.2 sub LN } if
  [ i 1 add 2 string cvs ] zx ZW 2 div sub 0.25 0 0.14 1 TX
  [ i 1 add 2 string cvs ] zx ZW 2 div sub BH 0.25 sub 0 0.14 1 TX
} for
0 1 NY 1 sub { /i exch def /zy 0.5 i ZH mul add def
  i 0 gt { 0.2 zy 0.5 zy LN BW 0.5 sub zy BW 0.2 sub zy LN } if
  /zs 1 string def zs 0 i 65 add put
  [ zs ] 0.25 zy ZH 2 div add 0 0.14 1 TX
  [ zs ] BW 0.25 sub zy ZH 2 div add 0 0.14 1 TX
} for

% The title block in the lower right corner: its lines, its labels
% (.10 in), its entries (.12 in) and the larger ones, with BL and BT
% from its lower left corner.
Eng length 0 eq { /Eng Drawn def } if
/BX BW 10.2 sub def /BY 0.5 def
/BL { /y1 exch def /x1 exch def /y0 exch def /x0 exch def
  BX x0 add BY y0 add BX x1 add BY y1 add LN } def
/BT { /ba exch def /bh exch def /by exch def /bx exch def
  BX bx add BY by add 0 bh ba TX } def
0 0 0 2.5 BL
0 2.5 9.7 2.5 BL
2 0 2 2.5 BL
4.45 0 4.45 2.5 BL
0 1.45 2 1.45 BL
0 0.4 4.45 0.4 BL
2 0.8 4.45 0.8 BL
4.45 1.9 9.7 1.9 BL
4.45 0.75 9.7 0.75 BL
4.45 0.25 9.7 0.25 BL
4.8 0.25 4.8 0.75 BL
6.7 0.25 6.7 0.75 BL
9.2 0.25 9.2 0.75 BL
5.6 0 5.6 0.25 BL
8 0 8 0.25 BL
[ (MATERIAL) ] 0.08 2.36 0.1 0 BT
[ (FINISH) ] 0.08 1.31 0.1 0 BT
[ (DO NOT SCALE DRAWING) ] 1 0.2 0.12 1 BT
[ (UNLESS OTHERWISE SPECIFIED,) ] 2.1 2.36 0.1 0 BT
[ (DIMENSIONS ARE IN INCHES.) ] 2.1 2.2 0.1 0 BT
[ (TOLERANCES:) ] 2.1 1.95 0.1 0 BT
[ (.XX) ] 2.9 1.7 0.12 2 BT
[ /PM (.02) ] 3.1 1.7 0.12 0 BT
[ (.XXX) ] 2.9 1.45 0.12 2 BT
[ /PM (.010) ] 3.1 1.45 0.12 0 BT
[ (ANGLE) ] 2.9 1.2 0.12 2 BT
[ /PM (1) /DEG ] 3.1 1.2 0.12 0 BT
[ (ENG BY/DATE) ] 2.06 0.71 0.1 0 BT
[ Eng ] 2.1 0.52 0.12 0 BT
[ (DWN BY/DATE) ] 2.06 0.32 0.1 0 BT
[ Drawn ] 2.1 0.12 0.12 0 BT
[ (DRAWING TITLE:) ] 4.53 1.81 0.1 0 BT
[ Title ] 7.07 1.3 0.2 1 BT
[ (SIZE) ] 4.5 0.67 0.1 0 BT
[ (B) ] 4.62 0.42 0.17 1 BT
[ (FILENAME:) ] 4.86 0.67 0.1 0 BT
[ Filename ] 5.75 0.42 0.12 1 BT
[ (PART NO.) ] 6.76 0.67 0.1 0 BT
[ Number ] 7.95 0.42 0.17 1 BT
[ (REV) ] 9.26 0.67 0.1 0 BT
[ Rev ] 9.45 0.42 0.17 1 BT
[ (SCALE:) ] 4.5 0.12 0.1 0 BT
[ Scale ] 5.2 0.12 0.12 1 BT
[ (SHEET:) ] 8.06 0.12 0.1 0 BT
[ Sheet ( OF ) Sheets ] 9 0.12 0.12 1 BT
MaterialNote length 0 gt { BX 1 add BY 1.9 add MaterialNote FLG } if
FinishNote length 0 gt { BX 1 add BY 0.85 add FinishNote FLG } if

% The revision table in the upper right corner, on the sheets that
% have revisions: its title, its heads and a row of .25 in for each.
/RX BW 7 sub def /RT BH 0.5 sub def /RR 0.25 def
Revisions length 0 gt {
  /n Revisions length def
  [ (REVISIONS) ] RX 3.25 add RT RR 2 div sub 0 0.12 1 TX
  [ 0 0.45 4.5 5.5 ] { /cx exch def RX cx add cx 0 gt { RT RR sub }
    { RT } ifelse RX cx add RT n 2 add RR mul sub LN } forall
  1 1 n 2 add { RR mul RT exch sub /ry exch def
    RX ry BW 0.5 sub ry LN } for
  [ (REV) ] RX 0.225 add RT RR 1.5 mul sub 0 0.1 1 TX
  [ (DESCRIPTION) ] RX 2.475 add RT RR 1.5 mul sub 0 0.1 1 TX
  [ (DATE) ] RX 5 add RT RR 1.5 mul sub 0 0.1 1 TX
  [ (APPROVED) ] RX 6 add RT RR 1.5 mul sub 0 0.1 1 TX
  0 1 n 1 sub { /k exch def /r Revisions k get def
    /ry RT k 2.5 add RR mul sub def
    [ r 0 get ] RX 0.225 add ry 0 0.12 1 TX
    [ r 3 get ] RX 0.55 add ry 0 0.12 0 TX
    [ r 1 get ] RX 5 add ry 0 0.12 1 TX
    [ r 2 get ] RX 6 add ry 0 0.12 1 TX } for
} if
