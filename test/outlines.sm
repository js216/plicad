# Fuzzer finding: the location of the first outline leaked when the
# second one followed.
sheet 1 1 0.4
plate p 0 0 50 40 origin 0 0 0 axes +x +y
outline along z
point 100 10
point 120 10
point 120 20
outline along z
point 10 10
point 20 10
point 20 20
