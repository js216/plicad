[ Eng ] 2.1 0.52 0.12 0 BT
[ (DWN BY/DATE) ] 2.06 0.32 0.1 0 BT
[ Drawn ] 2.1 0.12 0.12 0 BT
[ (DRAWING TITLE:) ] 4.53 1.81 0.1 0 BT
[ Title ] 7.07 1.3 0.2 1 BT
[ (SIZE) ] 4.5 0.67 0.1 0 BT
[ (C) ] 4.62 0.42 0.17 1 BT
[ (FILENAME:) ] 4.86 0.67 0.1 0 BT
[ Filename ] 5.75 0.42 0.12 1 BT
[ (PART NO.) ] 6.76 0.67 0.1 0 BT
[ Number ] 7.95 0.42 0.17 1 BT
[ (REV) ] 9.26 0.67 0.1 0 BT
[ Rev ] 9.45 0.42 0.17 1 BT
[ (SCALE:) ] 4.5 0.12 0.1 0 BT
[ Scale ] 5.2 0.12 0.12 1 BT
[ (SHEET:) ] 8.06 0.12 0.1 0 BT
[ Sheet ( OF ) Sheets ] 9 0.12 0.12 1 BT
MaterialNote length 0 gt { BX 1 add BY 1.9 add MaterialNote FLG } if
FinishNote length 0 gt { BX 1 add BY 0.85 add FinishNote FLG } if

% The revision table in the upper right corner, on the sheets that
% have revisions: its title, its heads and a row of .25 in for each.
/RX BW 7 sub def /RT BH 0.5 sub def /RR 0.25 def
Revisions length 0 gt {
  /n Revisions length def
  [ (REVISIONS) ] RX 3.25 add RT RR 2 div sub 0 0.12 1 TX
  [ 0 0.45 4.5 5.5 ] { /cx exch def RX cx add cx 0 gt { RT RR sub }
    { RT } ifelse RX cx add RT n 2 add RR mul sub LN } forall
  1 1 n 2 add { RR mul RT exch sub /ry exch def
    RX ry BW 0.5 sub ry LN } for
  [ (REV) ] RX 0.225 add RT RR 1.5 mul sub 0 0.1 1 TX
  [ (DESCRIPTION) ] RX 2.475 add RT RR 1.5 mul sub 0 0.1 1 TX
  [ (DATE) ] RX 5 add RT RR 1.5 mul sub 0 0.1 1 TX
  [ (APPROVED) ] RX 6 add RT RR 1.5 mul sub 0 0.1 1 TX
  0 1 n 1 sub { /k exch def /r Revisions k get def
    /ry RT k 2.5 add RR mul sub def
    [ r 0 get ] RX 0.225 add ry 0 0.12 1 TX
    [ r 3 get ] RX 0.55 add ry 0 0.12 0 TX
    [ r 1 get ] RX 5 add ry 0 0.12 1 TX
    [ r 2 get ] RX 6 add ry 0 0.12 1 TX } for
} if

