%%BeginTemplate
% SPDX-License-Identifier: GPL-3.0-only
% plain_c.ps -- A plain C sheet, 22 x 17 in, a template for smsheet
% Copyright (c) 2026 Jakob Kastelic

%%PliCadPaper: 22 17
%%PliCadRoom: 0.9 0.9 21.1 16.1
%%PliCadKeep: 11.8 0.5 21.5 3
%%PliCadNotes: 0.9 0.9 6.4 16.1
%%PliCadRevisions: 15 21.5 16.5 0.25
%%PliCadFields: Title Number Rev Drawn Eng Filename

% The border and its zones, numbered from the right and lettered from
% the foot.
/BW 22 def /BH 17 def /NX 6 def /NY 4 def
0.02 setlinewidth [] 0 setdash 0.5 0.5 BW 1 sub BH 1 sub rectstroke
0.012 setlinewidth
/ZW BW 1 sub NX div def /ZH BH 1 sub NY div def
0 1 NX 1 sub { /i exch def /zx BW 0.5 sub i ZW mul sub def
  i 0 gt { zx 0.2 zx 0.5 LN zx BH 0.5 sub zx BH 0.2 sub LN } if
  [ i 1 add 2 string cvs ] zx ZW 2 div sub 0.25 0 0.14 1 TX
  [ i 1 add 2 string cvs ] zx ZW 2 div sub BH 0.25 sub 0 0.14 1 TX
} for
0 1 NY 1 sub { /i exch def /zy 0.5 i ZH mul add def
  i 0 gt { 0.2 zy 0.5 zy LN BW 0.5 sub zy BW 0.2 sub zy LN } if
  /zs 1 string def zs 0 i 65 add put
  [ zs ] 0.25 zy ZH 2 div add 0 0.14 1 TX
  [ zs ] BW 0.25 sub zy ZH 2 div add 0 0.14 1 TX
} for

% The title block in the lower right corner: its lines, its labels
% (.10 in), its entries (.12 in) and the larger ones, with BL and BT
% from its lower left corner.
Eng length 0 eq { /Eng Drawn def } if
/BX BW 10.2 sub def /BY 0.5 def
/BL { /y1 exch def /x1 exch def /y0 exch def /x0 exch def
  BX x0 add BY y0 add BX x1 add BY y1 add LN } def
/BT { /ba exch def /bh exch def /by exch def /bx exch def
  BX bx add BY by add 0 bh ba TX } def
0 0 0 2.5 BL
0 2.5 9.7 2.5 BL
2 0 2 2.5 BL
