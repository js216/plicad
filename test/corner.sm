# SPDX-License-Identifier: GPL-3.0-only
# corner.sm -- An open box corner with a gap and a stepped wall notch
# Copyright (c) 2026 Jakob Kastelic

# The panel bends to full-length side walls and to shorter top and
# bottom flanges.  The side bends end flush with the panel, each top and
# bottom flange stops a gap short of the side bends, and each wall stays
# below the top and bottom bends behind the flanges, with a rounded step.
sheet 2.286 0.762 0.44
T = 2.286
tr = T + 0.762
W = 100
H = 60
Leg = 15
Gap = 0.4*T
StepR = 1.11*T
Dn = tr + Leg + StepR
plate panel tr tr W-tr H-tr origin 0 0 0 axes +x +z
flange left panel -x -90 40 span 0 H zone tr H-tr
flange right panel +x -90 40 span 0 H zone tr H-tr
flange top panel +y -90 Leg span tr+Gap W-tr-Gap
flange bottom panel -y -90 Leg span tr+Gap W-tr-Gap
cut -1 H-tr Dn H+1 along x at 0 depth 2*T
cut -1 -1 Dn tr along x at 0 depth 2*T
cut -1 H-tr Dn H+1 along x at W depth 2*T
cut -1 -1 Dn tr along x at W depth 2*T
round left StepR at 0 Dn H
round left StepR at 0 Dn 0
round right StepR at W Dn H
round right StepR at W Dn 0
