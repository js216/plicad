# SPDX-License-Identifier: GPL-3.0-only
# pcb_filter.pcb -- The layout of the filtered buffer of sch_filter.sch
# Copyright (c) 2026 Jakob Kastelic

# A board made up for the tests: the buffer on two signal layers, its
# planes inside.

netlist sch_filter.expected
board rect 0 0 40 30
layer top signal
layer in1 plane GND
layer in2 plane +12V
layer bottom plane -12V
rule clearance 0.2
rule track 0.2
rule via 0.6 0.3
rule viagap 0.3
rule maskweb 0.1
footprint ti/lmh6609 so8
footprint resistor r0603
footprint capacitor c0603
footprint ferrite l0603

fix filter.buf.amp at 20 18 rot 270
place filter.buf.rf left of filter.buf.amp
place filter.buf.rg up from filter.buf.amp.in-
place filter.vpos.c down from filter.buf.amp.v+
place filter.vpos.fb right of filter.vpos.c
place filter.vneg.c up from filter.buf.amp.v-
place filter.vneg.fb left of filter.vneg.c
place filter.lpf.r down from filter.buf.amp.out
place filter.lpf.c down from filter.lpf.r.2
place filter.lpf.c2 right of filter.lpf.c
width OUT 0.4
