# roundfirst.part -- Rounds before a union, which bool refuses
# Copyright (c) 2026 Jakob Kastelic

profile r along z 0 0 0 20 0 0 20 10 0 0 10 0
extrude blk from 0 to 5 r
extrude top from 5 to 9 r
round 1 blk.r.0 blk.r.1
round 1 blk.r.0 blk.start
round 1 blk.r.1 blk.start
union u blk top
