%!PS-Adobe-3.0
%%Creator: smsheet
%%Pages: 1
%%DocumentMedia: paper 1224 792 0 () ()
%%EndComments
/osifont findfont dup length dict begin
{ 1 index /FID ne { def } { pop pop } ifelse } forall
/Encoding ISOLatin1Encoding dup length array copy
dup 45 /hyphen put def currentdict end
/Lettering exch definefont pop
/H 1 def
/LN { newpath moveto lineto stroke } bind def
/AR { newpath arc stroke } bind def
/L { lineto } bind def
/M { moveto } bind def
/A { 2 copy gt { arcn } { arc } ifelse } bind def
/FILL { 0.9 setgray eofill 0 setgray } bind def
/SYM { H 0.75 mul } bind def
/PEN { H 0.075 mul setlinewidth [] 0 setdash stroke } bind def
/DIA { currentpoint gsave translate newpath
  H 0.36 mul H 0.5 mul H 0.3 mul 0 360 arc
  H 0.1 mul H -0.05 mul moveto H 0.62 mul H 1.05 mul lineto
  PEN grestore SYM 0 rmoveto } bind def
/CSK { currentpoint gsave translate newpath
  H 0.08 mul H 0.8 mul moveto H 0.56 mul H 0.2 mul lineto
  H 1.04 mul H 0.8 mul lineto PEN grestore
  H 1.2 mul 0 rmoveto } bind def
/DEG { (\260) show } bind def
/PM { (\261) show } bind def
/WID { 0 exch { dup type /nametype eq
  { dup /DIA eq { pop SYM } { /CSK eq { H 1.2 mul }
    { (\260) stringwidth pop } ifelse } ifelse }
  { stringwidth pop } ifelse add } forall } bind def
/TX { gsave /al exch def /H exch def /rt exch def translate
  rt rotate /Lettering findfont H 1.3518 mul scalefont setfont
  dup WID al mul -2 div H -2 div moveto
  { dup type /nametype eq { cvx exec } { show } ifelse }
  forall grestore } bind def
/ARROW { gsave 2 copy exch atan 5 3 roll translate rotate
  newpath 0 0 moveto -0.13 0.022 lineto -0.13 -0.022 lineto
  closepath fill grestore pop pop } bind def
/DOT { newpath 0.025 0 360 arc fill } bind def
/CLEAR { 4 dict begin /y1 exch def /x1 exch def /y0 exch def
  /x0 exch def newpath -1e3 -1e3 moveto 1e3 -1e3 lineto
  1e3 1e3 lineto -1e3 1e3 lineto closepath x0 y0 moveto
  x1 y0 lineto x1 y1 lineto x0 y1 lineto closepath eoclip
  end } bind def
/HATCH { /hy1 exch def /hx1 exch def /hy0 exch def
  /hx0 exch def hx0 hy0 hx1 hx0 sub hy1 hy0 sub rectclip
  hx0 hy1 sub 0.08 div ceiling 1 hx1 hy0 sub 0.08 div floor
  { 0.08 mul dup hy0 add hy0 moveto hy1 add hy1 lineto
    stroke } for } bind def
/FLG { 3 copy pop 0.12 sub exch 0.12 sub exch 0.24 0.24
  0.008 setlinewidth [] 0 setdash rectstroke NUM } bind def
/NUM { 3 1 roll [ 4 -1 roll ] 3 1 roll 0 0.120 1 TX } bind def
%%Page: 1 1
<< /PageSize [1224 792] >> setpagedevice
gsave 72 dup scale 1 setlinecap 1 setlinejoin
% sheet 1: scale 0.75, the views cover 0.42 of the free sheet
/Title (CUP, CUBICAL) def
/Number (TBD) def
/Rev (A) def
/Drawn (JK 11/13/26) def
/Filename where { pop } { /Filename (cube) def } ifelse
/Title where { pop } { /Title () def } ifelse
/Number where { pop } { /Number () def } ifelse
/Rev where { pop } { /Rev () def } ifelse
/Drawn where { pop } { /Drawn () def } ifelse
/Eng where { pop } { /Eng () def } ifelse
/Filename where { pop } { /Filename () def } ifelse
/Paper (17 x 11) def
/Scale (0.75) def
/Sheet (1) def
/Sheets (1) def
/MaterialNote (1) def
/FinishNote (2) def
/Revisions [
  [ (A) (11/13/26) (JK) (INITIAL RELEASE) ]
] def
gsave 100 dict begin
